2. Servlet Program (LoginServlet.java)
package servletpackage;

import java.io.*;
import javax.servlet.*;
import javax.servlet.http.*;

public class LoginServlet extends HttpServlet
{
    public void doGet(HttpServletRequest req,
                      HttpServletResponse res)
                      throws ServletException, IOException
    {
        res.setContentType("text/html");

        PrintWriter pw = res.getWriter();

        String name = req.getParameter("uname");

        // Cookies
        Cookie ck = new Cookie("user", name);
        res.addCookie(ck);

        // Session
        HttpSession session = req.getSession();
        session.setAttribute("uname", name);

        pw.println("<h2>Welcome : " + name + "</h2>");

        // URL Rewriting
        pw.println("<a href='next?uname="
                   + name + "'>Next Page</a>");
    }
}
3. Next Servlet (NextServlet.java)
package servletpackage;

import java.io.*;
import javax.servlet.*;
import javax.servlet.http.*;

public class NextServlet extends HttpServlet
{
    public void doGet(HttpServletRequest req,
                      HttpServletResponse res)
                      throws ServletException, IOException
    {
        res.setContentType("text/html");

        PrintWriter pw = res.getWriter();

        // URL Rewriting
        String uname = req.getParameter("uname");

        pw.println("<h2>User Name from URL Rewriting : "
                   + uname + "</h2>");

        // Cookies
        Cookie c[] = req.getCookies();

        if(c != null)
        {
            pw.println("<h2>User Name from Cookie : "
                       + c[0].getValue() + "</h2>");
        }

        // Session
        HttpSession session = req.getSession(false);

        if(session != null)
        {
            String sname =
              (String)session.getAttribute("uname");
            pw.println("<h2>User Name from Session : "+ sname + "</h2>");
        }
    }
}
